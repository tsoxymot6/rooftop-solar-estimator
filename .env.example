# No credentials are required by any dataset used in this project.
# Optional settings (names only - never commit values for secrets):
RSE_CORS_ORIGINS=*                 # comma-separated origins allowed to call the API
RSE_NOMINATIM_EMAIL=               # optional contact email sent to Nominatim in the User-Agent (usage policy)
RSE_OVERPASS_URL=                  # optional preferred Overpass mirror
RSE_MAX_JOB_KM2=2.5                # analysis-size limit for user-selected areas
